// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
// =============================================================================
{
  "name": "openlist-tsworkers",
  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  // ===========================================================================
  // 普通环境变量
  // 注意：vars 会在每次 wrangler deploy 时被本文件覆盖（Secrets 不会）。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",

    // 数据存储格式：改用 KV 必须用 map
    "DB_FORMAT": "map",

    // 数据库驱动：强制使用 Cloudflare KV
    "DB_DRIVER": "kv",

    "DB_CIPHER": "none",

    "CACHE_ENABLED": "true",
    "CACHE_DRIVER": "db",
    "CACHE_FILE_TREE": "true",
    "CACHE_DOWNLOAD_LINK": "false",
    "CACHE_TTL": "0",
    "CACHE_LINK_TTL": "5",
    "CACHE_EXCLUDE_DRIVERS": "virtual,alias,url_tree,strm,chunk",
    
    "SINGLEFLIGHT": "auto",
  },

  // ===========================================================================
  // 存储绑定
  // ===========================================================================
  
  // ▶ 启用 KV，并直接填入了你刚才提供的 ID
  "kv_namespaces": [
    { 
      "binding": "KV", 
      "id": "c2fa2d1affd64393989d32ac6ea68e26" 
    }
  ],

  // ▶ D1 数据库（已注释，不用它了）
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "openlist-db",
  //     "database_id": "7dead793-56e3-4021-b67c-5b57b8285260"
  //   }
  // ],
}
